{
  "name": "@whm/utxo",
  "private": true,
  "type": "module",
  "scripts": {
    "start:api": "node dist/api/app.js",
    "start:relayer": "node dist/relayer/app.js",
    "prebuild": "npm run clean",
    "build": "node ./esbuild.dist.mjs",
    "clean": "rm -rf dist/",
    "dev": "node ./esbuild.dev.mjs",
    "docker:build": "docker build -t galacticcouncil/utxo:latest .",
    "docker:deploy": "docker buildx build --platform linux/amd64 -t galacticcouncil/utxo:latest --push .",
    "docker:up": "docker stack deploy -c docker-compose.yml utxo"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "near-api-js": "^7.3.1",
    "polkadot-api": "^2.1.0",
    "viem": "^2.46.1",
    "winston": "^3.8.2"
  }
}
