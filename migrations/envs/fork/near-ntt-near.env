# === NEAR (hub) — local sandbox from `pnpm fork:near` ===
RPC_NEAR=http://127.0.0.1:3030
WORMHOLE_ID_NEAR=15
# The mainnet core code, booted on the fork guardian (crates/near/scripts/ntt-manager/fork.ts).
WORMHOLE_CORE_NEAR=wormhole.test.near
# The sandbox root; PK_NEAR is read from its key by sh/migrate-near-ntt-near.sh.
NEAR_ACCOUNT=test.near
NTT_PREFIX=ntt-near
NTT_BALANCE=10
# Plain `cargo build` output is fine on the fork, but loses panic messages (refusals show as
# `unreachable`). Build: cargo build -p ntt-manager --target wasm32-unknown-unknown --release
# (in crates/near). Use `pnpm run build` (cargo near) for messages, and always for prod.
NTT_WASM=crates/near/target/wasm32-unknown-unknown/release/ntt_manager.wasm

# === Token ===
# The mainnet wrap.near code (24 dp).
TOKEN_NEAR=wrap.test.near

# === Limits — 1,000 NEAR / 24 h each way ===
NEAR_OUTBOUND_LIMIT=1000000000000000000000000000
NEAR_INBOUND_LIMIT=1000000000000000000000000000

# === Hydration (spoke) ===
# Not deployed on the NEAR fork — these match what forkVaa.ts signs as (its defaults): the wNEAR NTT
# pair chopsticks/probes/_probeNearNttDelivery.ts deploys on a Hydration fork.
WORMHOLE_ID_HYDRATION=73
HYDRATION_NTT_MANAGER=0x5b1334885320cFd7158760256c7bD0Af58006b09
HYDRATION_NTT_TRANSCEIVER=0x5e875F689EA8dd25e11a69cfb6C9f844C4b3B207
HYDRATION_TOKEN_DECIMALS=24

# === Ownership ===
# Kept on the root so the fork contract stays configurable after the run.
NTT_NEW_OWNER=test.near
