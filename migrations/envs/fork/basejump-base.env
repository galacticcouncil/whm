# === Base (source) ===
RPC_BASE=http://127.0.0.1:8546
CHAIN_ID_BASE=8453
WORMHOLE_ID_BASE=30
WORMHOLE_CORE_BASE=0xbebdb6C8ddC678FfA9f8748f85C815C556Dd8ac6

# === Hydration EVM (receiver) ===
RPC_HYDRATION=http://127.0.0.1:8547
CHAIN_ID_HYDRATION=222222
WORMHOLE_ID_HYDRATION=73
# Wormhole Core on Hydration — verified: chainId()=73, guardian set 7, messageFee()=0
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941B2805181771795D9176fA82A1

# === Settlement: NTT, Base -> Hydration ===
# Destination chain id is a contract constant (Hydration), not config.
EURC_SOURCE_ASSET=0x60a3E35Cc302bFA44Cb288Bc5a4F316Fdb1adb42
# From hydration-ntt ops/tokens/eurc/deployment.json (Base leg, mode=locking).
# Outbound limit on this leg: 100,000 EURC / 24h sliding window.
EURC_NTT_MANAGER=0xD1dc3517732c98502b5c1ba2389AcA9E9016d89a
# Fee retained by the landing, 6 decimals
EURC_FEE_AMOUNT=100000

# === Landing pool (EXISTING — shared, not deployed by this migration) ===
# The live pool from the MRL deployment's 004-deploy-landing (see
# deployments/archive/basejump-base.json), shared with basejump-ethereum. TC-owned
# (emergency admin 0xaa7e…aa7e1). Step 007 (receiver) and step 011 (the Safe's arming call on
# the emitter) read this one value, which is what makes invariant 1 hold by construction.
#
# It does NOT serve Base EURC today. Referendum #404 unmapped it (setDestAsset(EURC, 0)), sent its
# EURC float to the Treasury and seeded USDC for the Ethereum corridor. Read on chain at Hydration
# block 16,702,133: destAssetFor(EURC_SOURCE_ASSET) = 0, EURC (asset 44) balance 0,
# USDC (asset 21) balance 10,007.4. So running this migration opens nothing on its own, and the
# Base emitter is deployed DISARMED (landing unset: bridgeViaWormhole reverts before pulling any
# token) until the Base TC Safe arms it as the last switch-on step (step 011 records the call).
HYDRATION_LANDING=0x70e9b12c3b19cb5f0e59984a5866278ab69df976

# === TC motion + Treasury referendum on Hydration (after this migration) ===
# Step 010 checks the landing, then records and prints the two landing calls of the TC motion:
#   1. landing.setDestAsset(EURC_SOURCE_ASSET, EURC_DEST_ASSET)
#   2. landing.setAuthorizedBridge(<005-deploy-receiver.proxyAddress>, true)   <- go-live switch
# The landing does not scope a bridge to an asset, so (2) grants authority over the whole pool:
# a Base-emitter message naming another mapped asset (e.g. Ethereum USDC) would be paid from it.
# Only an emitter upgrade or setNttManager by its owner, the Base TC Safe, could publish one; that
# Safe already owns the Ethereum emitter, so the set of parties who can move the pool is unchanged.
# Hydration EURC, asset 44. Step 010 refuses unless it equals the token() of the Hydration EURC
# NttManager below and that manager peers with EURC_NTT_MANAGER (BURNING side of the leg).
EURC_DEST_ASSET=0x000000000000000000000000000000010000002C
EURC_NTT_MANAGER_HYDRATION=0x8dd1286A29dF5a2785FB638d6fB1598144Cfbc4C
# The pool also needs EURC: a Treasury referendum buys it and sends the float (10,000 EURC
# proposed; the probe's --float sets it) to the landing.
# Build, enact and check both on a fork:
#   npx tsx chopsticks/probes/_probeBasejumpBaseGoLive.ts --receiver <005-deploy-receiver.proxyAddress>
# Checklist: docs/basejump/base-eurc.md

# === Ownership ===
# Base Technical Committee Safe — Gnosis Safe v1.4.1, 4-of-7.
# Also owns the Base EURC NttManager and its transceiver.
BASE_TC_SAFE=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7
# Hydration Technical Committee (EmergencyAdminAccount).
# Also owns all 11 Hydration NTT managers and the landing above.
RECEIVER_NEW_OWNER=0xaa7e0000000000000000000000000000000aa7e1

# === Legacy deployment (superseded, disarmed separately) ===
# Read by NO step — recorded here so the operator has the disarm target to hand.
# Both senders below must read landingDest() = 0 BEFORE the new emitter is armed (step 011).
# Safe calls setLandingDest(0) on this to close the dead MRL settlement path.
BASEJUMP_BASE_LEGACY=0xf5b9334e44f800382cb47fc19669401d694e529b
# The MRL-era XcmTransactor's Moonbeam MDA (003-deploy-transactor.mdaH160) — that is what
# holds the authorization on the landing, not the transactor proxy. Revoke with
# landing.setAuthorizedBridge(this, false) in the same TC batch as the go-live call.
# Already done: referendum #404 revoked it (authorizedBridges = false at Hydration block 16,702,133).
XCM_TRANSACTOR_MDA_LEGACY=0x10c06f418a082e636ee932ce8f9c5e791b925b51
# First direct (NTT) source, superseded by this migration's fresh deploy — it drops the unused
# tokenBridge slot. Still armed (landingDest + EURC manager set) and deployer-owned, so a call
# would settle gross into the pool with no receiver to pay the sender: disarm with
# setLandingDest(0). Record: deployments/archive/basejump-base-ntt.json.
BASEJUMP_BASE_SUPERSEDED=0x9c007310c2972f656bc4903a16f936fc0cfbc4d2
