# === Hydration EVM ===
# anvil fork, sh/fork-hydration.sh
RPC_HYDRATION=http://127.0.0.1:8547
CHAIN_ID_HYDRATION=222222

# === Landing proxy (EXISTING — the pool this implementation is for; nothing here deploys it) ===
# deployments/archive (MRL-era basejump-base) — 001-deploy-landing. Owner is the Hydration TC
# emergency admin (0xaa7e…aa7e1). Holds the USDC pool; the upgrade swaps code only.
HYDRATION_LANDING=0x70e9b12c3b19cb5f0e59984a5866278ab69df976

# === Receiver proxy (EXISTING — read only, to check the artifact dispatches the selector it calls) ===
# deployments/prod/basejump-ethereum.json — 005-deploy-receiver.
HYDRATION_RECEIVER=0x35bf3a1b9ac564c8f66c97cea1ee410cd3f97c8a

# === Governance action on Hydration (read by NO step — recorded for the operator) ===
# TC motion: technicalCommittee.propose(threshold,
#   dispatcher.dispatchAsEmergencyAdmin(evm.call(admin, HYDRATION_LANDING, <upgradeCalldata>, ..)))
#   Step 001 prints and records the EVM calldata (`upgradeCalldata`).
#   Build + verify the motion: npx tsx chopsticks/probes/_probeBasejumpLandingUpgrade.ts --impl <implAddress>
