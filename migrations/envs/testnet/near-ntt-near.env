# === NEAR testnet (hub) ===
# Real testnet Wormhole core, observed by the testnet guardian (guardian set 0) — verified:
# message_fee()=0, guardian_set_index=0. There is no Hydration testnet on Wormhole: the Hydration
# half is checked on a chopsticks fork (chopsticks/probes/_probeNearNttDelivery.ts).
RPC_NEAR=https://rpc.testnet.near.org
WORMHOLE_ID_NEAR=15
WORMHOLE_CORE_NEAR=wormhole.wormhole.testnet
# Testnet account, signing with PK_NEAR — created via the testnet faucet (key: crates/near/.testnet/, gitignored).
NEAR_ACCOUNT=whm-ntt-0bugdc.testnet
NTT_PREFIX=ntt-near
NTT_BALANCE=4
# `pnpm --filter @whm/crates-near build` (cargo near). Relative to the repo root.
NTT_WASM=crates/near/target/near/ntt_manager/ntt_manager.wasm

# === Token ===
# wNEAR on testnet — 24 dp, 0.00125 NEAR registration, same as wrap.near.
TOKEN_NEAR=wrap.testnet

# === Limits — 100 wNEAR / 24 h each way ===
NEAR_OUTBOUND_LIMIT=100000000000000000000000000
NEAR_INBOUND_LIMIT=100000000000000000000000000

# === Hydration (spoke) — the wNEAR NTT pair chopsticks/probes/_probeNearNttDelivery.ts deploys ===
# No Hydration on Wormhole testnet: the probe deploys NttManager (BURNING) + WormholeTransceiver on a
# Hydration fork from a fixed, fresh deployer, so these CREATE addresses are known in advance. The
# NEAR testnet contract peers with them; the probe delivers the real testnet VAA to them.
WORMHOLE_ID_HYDRATION=73
HYDRATION_NTT_MANAGER=0x5b1334885320cFd7158760256c7bD0Af58006b09
HYDRATION_NTT_TRANSCEIVER=0x5e875F689EA8dd25e11a69cfb6C9f844C4b3B207
# The fork's wNEAR asset (id 1355), 24 dp — NEAR trims to min(8, 24, 24) = 8.
HYDRATION_TOKEN_DECIMALS=24

# === Ownership ===
# Keep it on the deployer, so the testnet contract stays configurable. Set to NEAR_ACCOUNT.
NTT_NEW_OWNER=whm-ntt-0bugdc.testnet
