# === NEAR testnet ===
RPC_NEAR=https://rpc.testnet.near.org
# Testnet account, signing with PK_NEAR — the near-ntt testnet deployer (key: crates/near/.testnet/, gitignored).
NEAR_ACCOUNT=whm-ntt-0bugdc.testnet

# === Contract ===
# Lands on zec-withdraw2.whm-ntt-0bugdc.testnet — the derivation predecessor of every withdraw account.
# (zec-withdraw.whm-ntt-0bugdc.testnet runs the first build, which read a page of coins on chain.)
WITHDRAW_PREFIX=zec-withdraw2
# ~204 KB of code at 1e19 yocto/byte ≈ 2.05 NEAR, plus headroom.
WITHDRAW_BALANCE=3
# `cargo near build non-reproducible-wasm` in crates/near/contracts/utxo-withdraw. Relative to the repo root.
WITHDRAW_WASM=crates/near/target/near/utxo_withdraw/utxo_withdraw.wasm
WITHDRAW_CHAIN=ZcashTestnet
# Blocks a signed delegate stays valid (~1–2 min) — the contract caps it at 100.
WITHDRAW_VALIDITY=100
# Gas of the delegate's ft_transfer_call — the connector schedules a 100 TGas callback inside it.
WITHDRAW_TGAS=200

# === Omni testnet (bridge-sdk-js TESTNET_ADDRESSES) — checked live 2026-10-16 ===
# Ed25519 domain 1 live on the testnet signer.
MPC_SIGNER_NEAR=v1.signer-prod.testnet
CONNECTOR_NEAR=zcash_connector.n-bridge.testnet
CONNECTOR_CHAIN=ZcashTestnet
TOKEN_NEAR=nzcash.n-bridge.testnet

# === Ownership ===
# Keep it on the deployer, so the testnet contract stays upgradeable from here.
WITHDRAW_NEW_OWNER=whm-ntt-0bugdc.testnet
