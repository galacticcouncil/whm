# === Hydration EVM ===
# NOTE: must be an EVM JSON-RPC endpoint. https://rpc.hydradx.cloud (used by
# basejump-base.env) is the SUBSTRATE endpoint and returns HTML here.
RPC_HYDRATION=https://rpc.kril.hydration.cloud
CHAIN_ID_HYDRATION=222222
WORMHOLE_ID_HYDRATION=73
# Wormhole Core on Hydration — verified: chainId()=73, guardian set 7, messageFee()=0
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941B2805181771795D9176fA82A1

# === Source corridor: Base ===
WORMHOLE_ID_BASE=30
# NEW Basejump on Base — a fresh deployment is a NEW Wormhole emitter, so this must
# NOT be the legacy 0xf5b9334e…529b. Copy 001-deploy-basejump.proxyAddress from
# deployments/<context>/basejump-base-ntt.json after that migration completes.
# Step 002 hard-stops while this is zero.
BASEJUMP_BASE=0x9c007310c2972f656bc4903a16f936fc0cfbc4d2

# === Landing pool (EXISTING — not deployed by this migration) ===
# The live pool from prod basejump-base step 004-deploy-landing. Already owned by the
# Hydration TC and already mapped EURC -> asset 44 (prod step 013-set-eurc@landing), so
# this migration only points the receiver at it. Must be byte-identical to
# HYDRATION_LANDING in basejump-base-ntt.env — that is invariant 1.
HYDRATION_LANDING=0x70e9b12c3b19cb5f0e59984a5866278ab69df976

# === Ownership: Hydration Technical Committee (EmergencyAdminAccount) ===
# Also owns all 11 Hydration NTT managers and the landing above.
MESSAGE_RECEIVER_NEW_OWNER=0xaa7e0000000000000000000000000000000aa7e1
