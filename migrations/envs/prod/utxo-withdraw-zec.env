# === NEAR mainnet ===
RPC_NEAR=https://rpc.mainnet.near.org
# Deployer, signing with PK_NEAR. The contract is created as its sub-account.
NEAR_ACCOUNT=hydration-whm.near

# === Contract ===
# -> withdraw-zec.hydration-whm.near, beside ntt-zec.hydration-whm.near — the MPC derivation predecessor of every withdraw account. Once
# users send to an address derived under it, this id is permanent (docs/near-utxo/withdraw.md).
WITHDRAW_PREFIX=withdraw-zec
# ~217 KB of code at 1e19 yocto/byte ≈ 2.2 NEAR, plus headroom for an upgrade to larger code.
WITHDRAW_BALANCE=3
# `cargo near build non-reproducible-wasm --no-abi` in crates/near/contracts/utxo-withdraw. Relative to the repo root.
WITHDRAW_WASM=crates/near/target/near/utxo_withdraw/utxo_withdraw.wasm
WITHDRAW_CHAIN=Zcash
# Blocks a signed delegate stays valid (~1–2 min) — the contract caps it at 100.
WITHDRAW_VALIDITY=100
# Gas of the delegate's ft_transfer_call — the connector schedules a 100 TGas callback inside it.
WITHDRAW_TGAS=200

# === Omni mainnet (bridge-sdk-js MAINNET addresses) — checked live 2026-10-16 ===
MPC_SIGNER_NEAR=v1.signer
CONNECTOR_NEAR=zcash-connector.bridge.near
CONNECTOR_CHAIN=ZcashMainnet
TOKEN_NEAR=zec.omft.near

# === Ownership ===
# NEAR custodian for the contract's `owner`, as for near-ntt-zec. Step 002 proposes it; with the
# account's keys deleted (003) it is the only upgrade authority, and so controls every withdraw
# account. Step 004 waits until it calls `accept_ownership`.
#
# Canary first: run with `--pause-at 001-deploy-withdraw` (the runner stops after that step) — the
# deployer owns the contract and its key stays on the account, so a fix found by the canary is a
# quick redeploy. Re-run without the flag to hand over to the DAO and delete the keys.
WITHDRAW_NEW_OWNER=hydration.sputnik-dao.near
