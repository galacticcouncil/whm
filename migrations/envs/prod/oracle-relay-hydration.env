# === Hydration EVM (source) ===
RPC_HYDRATION=https://rpc.kril.hydration.cloud
CHAIN_ID_HYDRATION=222222
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941b2805181771795d9176fa82a1

# Feed sources (Hydration EMA oracle precompile, 8 dec, answer-only)
# 0x000001 | period 02 (TenMinutes) | source 0x00×8 (router route) | asset A 10 (USDT) | asset B 0 (HDX)
# => USDT per HDX, 10-minute EMA — the same read the money market's HDX-USDOracleAdapter makes
HDX_FEED=0x0000010200000000000000000000000a00000000

# === Robinhood Chain mainnet (direct receiver) ===
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID_ROBINHOOD=4663
WORMHOLE_CORE_ROBINHOOD=0x141fBa8AD5D61bdaB45A047cF60b5Ad9784987FB

# === Oracle registrations ===
# ASSET_ID    => keccak256(symbol) — must match what OracleEmitter publishes
# ORACLE_ADDRESS => oracle contract on Robinhood (must authorize the OracleReceiver as setPrice caller)

## HDX — deployed after 003-deploy-receiver, against its proxy address
HDX_ASSET_ID=0x8f515bbfa43ff773ef7c6c53cb11b1c7ead38052b30f6a928cc96c552714ca38
HDX_ORACLE_ADDRESS=0xD1a2198CBbC7cbfB602DF581D8614eD31682901D
