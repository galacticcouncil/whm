# intents-v2 — Hydration dispatcher, Ethereum forwarder, NEAR router. Design: docs/intents-v2/plan.md §4.
# Keys are not here: PK, PK_ETHEREUM, PK_NEAR come from the shell or the root .env.

# ── Chains ──────────────────────────────────────────────────────────────────
RPC_HYDRATION=https://hydration-rpc.n.dwellir.com
CHAIN_ID_HYDRATION=222222
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
CHAIN_ID_ETHEREUM=1
RPC_NEAR=https://rpc.mainnet.near.org
NEAR_ACCOUNT=hydration-whm.near

# ── Wormhole ────────────────────────────────────────────────────────────────
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941B2805181771795D9176fA82A1
WORMHOLE_CORE_ETHEREUM=0x98f3c9e6E3fAce36bAAd05FE09d375Ef1464288B
WORMHOLE_CORE_NEAR=contract.wormhole_crypto.near

# ── WETH NTT (hydration-ntt ops/tokens/weth) ────────────────────────────────
# Hydration manager — already NttManagerWithPayload.
NTT_MANAGER_HYDRATION=0xB5cEf790D52A57fa619eD96eDd64c5328F3DCFb7
NTT_TRANSCEIVER_ETHEREUM=0xbA0Cd32131b8206AF4feB79A1A3aaF0AEfe18b48

# ── Dispatcher config ───────────────────────────────────────────────────────
# DIA AggregatorV3 feeds on Hydration.
ETH_USD_FEED_HYDRATION=0x1AF549Fe19A9B73D094173C41e18BF7F357F594b
ZEC_USD_FEED_HYDRATION=0xd76f6e296e34ad163439d16731800c3e2c081c6e
ZEC_ASSET_NEAR=nep141:zec.omft.near
ZEC_DECIMALS_NEAR=8
# Seconds — above the longest observed gap between ETH/USD updates (~3.7 h).
MAX_FEED_AGE=21600
# Wei — POA's minimum ETH deposit.
MIN_ORDER_AMOUNT=100000000000

# ── Forwarder config ────────────────────────────────────────────────────────
# The relayer's Ethereum address — the exclusive window on processOrder.
RELAYER_1=0x43A8A728e2514EDEAe8e0C9FAb8B79fb5E4ecD5F

# ── Router ──────────────────────────────────────────────────────────────────
# The router lands on intents-router.hydration-whm.near — the MPC derivation predecessor.
ROUTER_PREFIX=intents-router
# NEAR — code storage for the ~265 KB wasm, with margin.
ROUTER_BALANCE=4
# `cargo near build reproducible-wasm` in crates/near/contracts/intent-router — never plain cargo build.
ROUTER_WASM=crates/near/target/near/intent_router/intent_router.wasm
MPC_SIGNER_NEAR=v1.signer
INTENTS_NEAR=intents.near
ETH_TOKEN_NEAR=nep141:eth.omft.near
# 1Click's quote-signing keys, comma-separated (one-click-sdk-typescript ONE_CLICK_MANAGER_PUB_KEY).
QUOTE_KEYS=ed25519:reYaWhvwu8Jzo3WUM3zhn6VrhuMEF4eADL17qtRVifc
# Seconds an order's price may be filled at, after its Hydration block.
ROUTER_PRICE_VALIDITY=900
# Seconds a signed transfer stays executable.
ROUTER_TRANSFER_VALIDITY=180
# Seconds — under the DCA period, so a quote cannot serve the next order.
ROUTER_MAX_QUOTE_AGE=30
# Bps — 1Click's default slippage; terms need maxSlippageBps above it.
ROUTER_MIN_QUOTE_SLIPPAGE_BPS=100
# Bps — a hedge for POA crediting less than deposited; 0 once the canary shows it exact.
ROUTER_MAX_ORDER_SHORTFALL_BPS=100
# Wei — the smallest refund, above POA's ETH withdrawal fee. At most 0.01 ETH.
ROUTER_MIN_REFUND=100000000000000

# ── Ownership (steps 011+) ──────────────────────────────────────────────────
# ETHEREUM_TC_SAFE stays empty until the canary passes — step 011 fails on it, so a full run stops
# there with every contract still the deployer's. Fill it in and re-run to hand over.
ETHEREUM_TC_SAFE=
HYDRATION_EMERGENCY_ADMIN=0xAA7e0000000000000000000000000000000AA7E1
ROUTER_NEW_OWNER=hydration.sputnik-dao.near
