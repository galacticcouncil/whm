# === Hydration ===
RPC_HYDRATION=https://rpc.hydradx.cloud
CHAIN_ID_HYDRATION=222222

# ZEC NttManager on Hydration (BURNING, peered with ntt-zec.hydration-whm.near) — send's rail.
ZEC_NTT_MANAGER_HYDRATION=0xe20cED5f5798cD4FeBc7aE182309b9f51345e0cC

# NEAR NttManager on Hydration (peered with ntt-near.hydration-whm.near) — refuel's rail.
NEAR_NTT_MANAGER_HYDRATION=0x374E5239a2342Be6Bf31B410EC03984D03A8b7dE

# ZEC each send keeps for the relayer's NEAR gas, zatoshi. A withdrawal costs ~0.005–0.008 NEAR;
# size it against the ZEC/NEAR rate at deploy time. Empty fails step 003.
ZEC_FEE=

# === Ownership ===
# Hydration Technical Committee (EmergencyAdminAccount). Takes the emitter, so setFee, refuel, sweep
# and every upgrade become TC calls.
HYDRATION_EMERGENCY_ADMIN=0xaa7e0000000000000000000000000000000aa7e1
