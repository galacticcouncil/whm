# Shared GovernanceDispatcher proxy from deployments/prod/governance-hydration.json,
# step 002-deploy-dispatcher-proxy. This migration refuses a missing or zero address.
GOVERNANCE_DISPATCHER_HYDRATION=

# === Ethereum destination ===
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
CHAIN_ID_ETHEREUM=1
WORMHOLE_CORE_ETHEREUM=0x98f3c9e6E3fAce36bAAd05FE09d375Ef1464288B
WORMHOLE_ID_ETHEREUM=2

# Gnosis Safe v1.4.1, 4-of-7. The migration verifies its code, threshold and owner count.
ETHEREUM_TC_SAFE=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7
ETHEREUM_TC_THRESHOLD=4
ETHEREUM_TC_OWNER_COUNT=7

VETO_PERIOD_SECONDS=86400
EXECUTION_GRACE_PERIOD_SECONDS=604800
