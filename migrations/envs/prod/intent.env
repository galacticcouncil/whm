# === Hydration ===
RPC_HYDRATION=https://rpc.hydradx.cloud
CHAIN_ID_HYDRATION=222222

# Wormhole core bridge on Hydration — publishes the order and the forwarding instruction.
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941B2805181771795D9176fA82A1

# WETH NttManager on Hydration. setNttManager reverts unless its token() is Hydration WETH (asset 20),
# so a wrong address fails the migration rather than the corridor.
NTT_MANAGER_HYDRATION=0xB5cEf790D52A57fa619eD96eDd64c5328F3DCFb7

# === Ethereum ===
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
CHAIN_ID_ETHEREUM=1

# Wormhole core bridge on Ethereum — verifies the emitter's instruction VAA.
WORMHOLE_CORE_ETHEREUM=0x98f3c9e6E3fAce36bAAd05FE09d375Ef1464288B

# WETH WormholeTransceiver on Ethereum — the receiver calls receiveMessage / isVAAConsumed on it.
# Counterpart of NTT_MANAGER_HYDRATION; nothing on-chain checks it, so verify before running.
NTT_TRANSCEIVER_ETHEREUM=0xbA0Cd32131b8206AF4feB79A1A3aaF0AEfe18b48

# === Ownership ===
# Hydration Technical Committee (EmergencyAdminAccount). Takes the emitter, so sweep,
# setNttManager, setIntentReceiver and every upgrade become TC calls.
HYDRATION_EMERGENCY_ADMIN=0xaa7e0000000000000000000000000000000aa7e1
# Technical Committee Safe — Gnosis Safe v1.4.1, 4-of-7, the same address basejump-ethereum
# hands its emitter to. Takes the receiver, so setAuthorizedRelayer needs 4 signatures.
ETHEREUM_TC_SAFE=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7

# Relayers granted the exclusive window on processOrder. Numbered so more can be added as their own
# steps; anyone may process once the window elapses.
RELAYER_1=0x43A8A728e2514EDEAe8e0C9FAb8B79fb5E4ecD5F
