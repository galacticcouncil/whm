# Shared GovernanceDispatcher proxy from deployments/prod/governance-hydration.json,
# step 002-deploy-dispatcher-proxy. This migration refuses a missing or zero address.
GOVERNANCE_DISPATCHER_HYDRATION=0x00302167f9597b9d90bd342311c5c4be39bf0fa0

# === Robinhood destination ===
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID_ROBINHOOD=4663
WORMHOLE_CORE_ROBINHOOD=0x141fBa8AD5D61bdaB45A047cF60b5Ad9784987FB
WORMHOLE_ID_ROBINHOOD=72

# Gnosis Safe v1.4.1, 4-of-7. Code, threshold and owner count verified on Robinhood mainnet on
# 2026-10-07. The migration reads and verifies them again immediately before proxy deployment.
ROBINHOOD_TC_SAFE=0xD557AeAf1e0cB3D226BfF3B7a10C2cdA9dA081E7
ROBINHOOD_TC_THRESHOLD=4
ROBINHOOD_TC_OWNER_COUNT=7

# Executor timing, in seconds. Contract-level bounds reject unsafe values independently.
VETO_PERIOD_SECONDS=86400
EXECUTION_GRACE_PERIOD_SECONDS=604800
