# === Robinhood Chain mainnet ===
RPC_ROBINHOOD=https://rpc.mainnet.chain.robinhood.com
CHAIN_ID_ROBINHOOD=4663
WORMHOLE_CORE_ROBINHOOD=0x141fBa8AD5D61bdaB45A047cF60b5Ad9784987FB

# Feed sources (Robinhood mainnet)
# Chainlink SPY/USD proxy — "RHSPY / USD", 8 dec, 0.5% / 24h, no rounds outside US-equity 24/5 hours
SPY_USD_FEED=0x319724394D3A0e3669269846abE664Cd621f9f6A
# ChainlinkAdapter max round age in seconds; 0 disables the check (immutable once deployed)
SPY_MAX_AGE=0

# === Hydration EVM (direct receiver) ===
RPC_HYDRATION=https://rpc.kril.hydration.cloud
CHAIN_ID_HYDRATION=222222
WORMHOLE_CORE_HYDRATION=0x3792a6d63c31941b2805181771795d9176fa82a1

# === Oracle registrations ===
# ASSET_ID    => keccak256(symbol) — must match what OracleEmitter publishes
# ORACLE_ADDRESS => oracle contract on Hydration EVM (must authorize the OracleReceiver as setPrice caller)

## SPY — deployed after 003-deploy-receiver, against its proxy address
SPY_ASSET_ID=0xcea23e8f56b5ac447ac08d57e0808e35f468a65f29bb659b3d48934481e7c67a
SPY_ORACLE_ADDRESS=0x0000000000000000000000000000000000000000
