# === NEAR (hub) ===
RPC_NEAR=https://rpc.mainnet.near.org
WORMHOLE_ID_NEAR=15
# Wormhole core on NEAR — verified: message_fee()=0, guardian set 7 (docs/near-ntt/verify.md).
WORMHOLE_CORE_NEAR=contract.wormhole_crypto.near
# Deployer, signing with PK_NEAR. The NTT contract is created as its sub-account.
NEAR_ACCOUNT=
# -> ntt-zec.<NEAR_ACCOUNT>
NTT_PREFIX=ntt-zec
# NEAR moved to the new account: code storage (~1 NEAR per 100 KB) plus state headroom.
NTT_BALANCE=5
# `cargo near build` output — run `pnpm --filter @whm/crates-near build` first. Relative to the repo root.
NTT_WASM=crates/near/target/near/ntt_manager/ntt_manager.wasm

# === Token ===
# NEP-141, 8 decimals, 0.00125 NEAR registration — both read from the token at deploy (step 001).
TOKEN_NEAR=zec.omft.near

# === Launch caps (docs/near-ntt/spec.md#launch-caps) — canary-sized, raised by the owner later ===
# The Governor does not apply to NTT (verify.md §2): these are the only caps on the route.
# NEAR outbound, token units (8 dp): 10 ZEC / 24 h.
NEAR_OUTBOUND_LIMIT=1000000000
# NEAR inbound from Hydration, token units (8 dp): 10 ZEC / 24 h.
NEAR_INBOUND_LIMIT=1000000000

# === Hydration (spoke) — deployed and peered from hydration-ntt ===
WORMHOLE_ID_HYDRATION=73
# From hydration-ntt's deployment.json (`add-chain Hydration --mode burning`). Step 004 peers the
# NEAR contract with these; hydration-ntt peers them back with 001's emitter.
HYDRATION_NTT_MANAGER=
HYDRATION_NTT_TRANSCEIVER=
# Decimals of the Hydration asset the manager mints.
HYDRATION_TOKEN_DECIMALS=

# === Ownership ===
# NEAR custodian for the NTT contract's `owner` (step 007).
NTT_NEW_OWNER=
